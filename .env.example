# Copiar este archivo como ".env" en la raíz del proyecto y completar los
# valores reales antes de levantar "docker compose up".
# NUNCA subir el .env real a git (ya está en .gitignore).

# ============================================================
# DJANGO
# ============================================================

# Generar una clave larga y aleatoria, por ejemplo con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# En producción SIEMPRE en False
DJANGO_DEBUG=False

# Dominio(s) reales separados por coma, sin protocolo (ej: verticetower.com,www.verticetower.com)
DJANGO_ALLOWED_HOSTS=

# Orígenes del frontend que pueden llamar a la API, con protocolo (ej: https://verticetower.com)
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# ============================================================
# BASE DE DATOS (PostgreSQL)
# ============================================================

POSTGRES_DB=vertice_tower
POSTGRES_USER=vertice_tower
POSTGRES_PASSWORD=
# En docker-compose el host es el nombre del servicio ("db"), no localhost
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ============================================================
# FRONTEND (se usa en build-time del contenedor de Nginx)
# ============================================================

# URL pública de la API, con protocolo y sin barra final (ej: https://verticetower.com/api)
VITE_API_URL=
